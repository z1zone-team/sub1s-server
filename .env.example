NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://sub1s_user:change-me@localhost:5432/sub1s_db?schema=public
VALKEY_HOST=localhost
VALKEY_PORT=6379
# VALKEY_PASSWORD=
# 음성 경로 추천 큐(BullMQ). VALKEY_HOST가 없으면 큐와 서버 워커는 꺼지고 POST /voice/jobs는 503이다
# VOICE_QUEUE_NAME=subway-voice          # AI 서비스(Python 워커)가 소비하는 STT 큐. 이름이 AI와 같아야 한다
# VOICE_PIPELINE_QUEUE_NAME=voice-route  # 서버 워커가 소비하는 큐
# VOICE_PIPELINE_CONCURRENCY=2           # 서버 워커가 동시에 처리하는 작업 수
# VOICE_QUEUE_MAX_WAITING=10             # 대기 작업이 이만큼 쌓이면 503 VOICE_QUEUE_FULL
# VOICE_ASYNC_MAX_AUDIO_BYTES=2097152    # 큐에 담는 오디오 상한(Valkey 메모리를 쓰므로 5MB보다 낮게)
# VOICE_STT_TIMEOUT_MS=25000             # AI 워커의 STT 결과를 기다리는 시간
# VOICE_JOB_TIMEOUT_MS=35000             # 작업 하나의 전체 제한 시간
# VOICE_JOB_RETENTION_SEC=600            # 끝난 작업(결과)을 보관하는 시간

# Public data APIs (values are set locally, never committed)
# 공휴일(특일 정보) 판정과 지하철 알림정보(운행 상태)에 쓴다
PUBLIC_DATA_API_KEY=
KRIC_API_KEY=
SEOUL_OPEN_API_KEY=
SEOUL_SUBWAY_REALTIME_API_KEY=
VWORLD_API_KEY=
# 아래는 모두 선택이며 비워 두면 기본값을 쓴다
# 장소 검색 IP당 분당 요청 한도 (기본 60)
PLACE_SEARCH_PER_MINUTE=
# V-World 일일 호출 상한 (기본 10000)
VWORLD_DAILY_LIMIT=
# 서울 실시간 도착정보 일일 호출 상한 (기본 700, 실시간 구현을 연결했을 때만 사용)
SEOUL_REALTIME_DAILY_LIMIT=
# Expo 푸시 보안 강화를 켠 경우의 액세스 토큰
EXPO_ACCESS_TOKEN=
# false면 월말정산 푸시 스케줄러를 끈다
PUSH_SCHEDULER_ENABLED=

# ---------------------------------------------------------------------------
# Datasets needed from data.go.kr (one account key: PUBLIC_DATA_API_KEY)
# Some OpenAPI datasets are LINK type and are served by KRIC with a separate key; file downloads need no key.
# Raw files are saved under data-raw/ (gitignored), only refined JSON is committed.
#
# [KRIC(철도산업정보센터, data.kric.go.kr) OpenAPI - data.go.kr이 아니라 KRIC에서 별도 키 발급 (KRIC_API_KEY)]
#  - 국가철도공단_도시철도 전체노선정보 (data.go.kr 15041666, LINK 유형)  https://www.data.go.kr/data/15041666/openapi.do
#      노선 구성/상하행/역 순서 (lineSeq 후보 출처, 응답 항목은 키 발급 후 확인)
#      서비스 링크: http://data.kric.go.kr/rips/M_01_02/detail.do?id=431&service=trainUseInfo&operation=subwayRouteInfo
#      Endpoint: https://openapi.kric.go.kr/openapi/trainUseInfo/subwayRouteInfo (REST, JSON/XML)
#      요청: serviceKey, format, mreaWideCd(01=수도권), lnCd(선코드)
#      응답: lnCd, mreaWideCd, railOprIsttCd, routCd, routNm, stinCd, stinConsOrdr(역구성순서), stinNm (상행->하행 순서)
#      확인됨: lnCd 필수, 응답 {"header":{...},"body":[...]}, lnCd 24개는 자료실 코드표 기준, 지선은 순번 공유로 표현
#      호출 규칙: 1일 1회 GET 또는 배치, 매크로 자제 (저장된 응답이 있으면 24시간 재호출 차단)
#  - 국가철도공단_역사별 환승정보 (data.go.kr 15041673, LINK 유형)        https://www.data.go.kr/data/15041673/openapi.do
#      승강장 이격거리/출입문 위치 (사용 여부 미확정)
#
# [활용신청 불필요 - 파일 다운로드]
#  - 국가철도공단_도시광역철도_역사정보 (15013205)  https://www.data.go.kr/data/15013205/standard.do
#      XLSX, 역번호/역명/노선/환승/위경도 (전국 1,073개 역, 수도권 필터 필요)
#  - 국가철도공단_수도권9호선_역간거리 (15041298)   https://www.data.go.kr/data/15041298/fileData.do
#      CSV, 역간거리만 있고 소요시간 없음 (9호선 38개 역)
#
# [서울 열린데이터광장 - 파일 다운로드 (SEOUL_OPEN_API_KEY는 API 사용 시에만)]
#  - 서울교통공사 역간거리 및 소요시간 (OA-12034), 환승역 환승거리/소요시간 (OA-13290)
#  - 서울교통공사 노선별 지하철역 정보 (OA-15442), 지하철 혼잡도 (OA-12928)
#
# [미확보] 신분당선, 수인분당선, 경의중앙선, 공항철도, 경춘선, 우이신설선, 신림선의
#          역간 소요시간 출처는 아직 찾지 못함 (거리만 있는 경우의 처리 방식은 미정)
# ---------------------------------------------------------------------------

# Kakao Local API REST key, used only by verify:stations-kakao (responses must not be stored)
KAKAO_REST_API_KEY=

# ODsay transit route API key, used only for route spot checks (30 calls/day, responses must not be stored)
ODSAY_API_KEY=

# 실제 보행로를 따라 걷는 거리와 경로를 구하는 OSRM(보행 프로필) 주소. 비워 두면 도보를 두 점의 직선 거리로 추정한다.
# 값이 있어도 응답이 없으면 직선 추정으로 돌아간다. 예: http://osrm:5000
# OSRM_URL=

# Clerk Authentication (Clerk Dashboard -> API Keys)
# - sk_test_... 형식의 Secret Key (서버 JWT 토큰 검증 및 유저 세션 확인용)
CLERK_SECRET_KEY=sk_test_sample_key
# - 이 키가 있어도 clerk-auth e2e는 RUN_LIVE_CLERK_E2E=1일 때만 실제 Clerk에 접속한다

# Mobile Client Verification Key (모바일 앱 X-Sub1S-Client-Key 헤더 검증용)
CLIENT_KEY=dev-mobile-client-key
